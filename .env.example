# ── Ambiente ─────────────────────────────────────────────────────────────
# development (local) | production (servidor)
FLASK_ENV=production

# Chave secreta da aplicação. Em produção, gere uma chave forte:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua-chave-secreta-muito-segura-e-aleatoria-aqui-123456

# ── Banco de dados ───────────────────────────────────────────────────────
# PostgreSQL online (Neon, Supabase, Railway) ou SQLite local.
# Exemplo Neon: postgresql://usuario:senha@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Exemplo Railway: postgresql://postgres:senha@containers-us-west-1.railway.app:1234/railway
# Exemplo SQLite local: sqlite:///beach_tennis.db
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# ── Primeiro administrador (criado pelo `flask seed`) ────────────────────
ADMIN_EMAIL=professor@beachtennis.com
ADMIN_PASSWORD=troque-esta-senha-no-deploy
ADMIN_NOME=Everson Vicktor Silva Silveira

# ── Dados de demonstração ────────────────────────────────────────────────
# 0 = não cria aluno de teste Lucas Silva em produção (recomendado)
# 1 = cria aluno de teste (apenas para desenvolvimento)
SEED_DEMO=0

# ── Uploads ──────────────────────────────────────────────────────────────
# Em produção com disco persistente, use o caminho montado (ex.: /data/uploads).
# Sem disco persistente, as imagens são perdidas a cada novo deploy.
# No Railway com volume em /data: UPLOAD_FOLDER=/data/uploads
# No Render com disco em /var/data: UPLOAD_FOLDER=/var/data/uploads
UPLOAD_FOLDER=app/static/uploads
